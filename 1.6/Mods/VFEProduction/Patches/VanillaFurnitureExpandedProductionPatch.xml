<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- ========== VFE_ComponentFabricationBench ========== -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VFE_ComponentFabricationBench"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VFE_ComponentFabricationBench"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName = "VFE_ComponentFabricationBench"]/comps</xpath>
		<value>
			<li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
				<randomGraphics>
					<li>Things/Building/Workbenches/ComponentFabricationBench</li>
					<li>Things/Building/VFEProduction/VEF_ComponentFabricationBench/VEF_ComponentFabricationBenchChimneys</li>
					<li>Things/Building/VFEProduction/VEF_ComponentFabricationBench/VEF_ComponentFabricationBenchComputer</li>
					<li>Things/Building/VFEProduction/VEF_ComponentFabricationBench/VEF_ComponentFabricationBenchDouble</li>
				</randomGraphics>
				<optionalNames>
					<li>Standard Component Fabrication bench</li>
					<li>Chimneys</li>
					<li>Computer</li>
					<li>Double</li>
				</optionalNames>
			</li>
		</value>
	</Operation>
